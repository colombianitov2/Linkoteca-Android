{
  "name": "linkoteca-android",
  "version": "1.0.4",
  "private": true,
  "description": "Linkoteca para Android con almacenamiento local en el dispositivo.",
  "scripts": {
    "android:sync": "npx cap sync android",
    "android:debug": "cd android && gradlew.bat assembleDebug",
    "android:release": "cd android && gradlew.bat assembleRelease",
    "android:release:signed": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android-release.ps1"
  },
  "dependencies": {
    "@capacitor/android": "7.4.3",
    "@capacitor/core": "7.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "7.4.3"
  }
}
